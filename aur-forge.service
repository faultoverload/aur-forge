[Unit]
Description=aur-forge — AUR build farm (24/7 mode)
Documentation=https://github.com/faultoverload/aur-forge
# Wait for the network so AUR RPC calls in update.sh work, and for
# the journal so log output is captured before our service starts.
After=network-online.target systemd-journald.service
Wants=network-online.target

[Service]
Type=simple
# run.sh calls init.sh (idempotent), starts darkhttpd in the
# background, then starts the nightly scheduler. It traps SIGTERM
# and forwards to both children. systemd manages the whole process
# group as a single Type=simple unit — darkhttpd + scheduler are
# direct children of the bash process, not separate units. This
# preserves the original 24/7 single-PID-group design.
ExecStart=/usr/local/bin/run.sh
# SIGTERM forward: run.sh's trap exits 0 within ~60s. After that
# systemd treats it as a clean stop and restarts per policy.
# Restart=always so a transient darkhttpd crash (e.g. port already
# bound after a fast redeploy) doesn't take the container down.
Restart=always
RestartSec=5
# run.sh drops privileges internally via sudo -u builder for
# makepkg. systemd-nspawn inside extra-x86_64-build needs
# CAP_SYS_ADMIN for chroot mount plumbing, so the service must run
# as root rather than as a dedicated user.
User=root
# Surface run.sh's stdout/stderr (which goes through bash trap
# output) to journald / docker logs via the conmon-style pipe.
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
